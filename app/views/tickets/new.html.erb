<div class="form-layout">
  <section>
    <h1>Destek talebi aç</h1>
    <p class="intro">Ekibimiz talebinizi aldığı andan itibaren seçtiğiniz önceliğe göre yanıt süresini işletir.</p>

    <div class="panel">
      <%= form_with model: @ticket do |form| %>
        <% if @ticket.errors.any? %>
          <ul class="errors">
            <% @ticket.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>

        <div class="field">
          <%= form.label :requester_email, "E-posta adresiniz" %>
          <%= form.email_field :requester_email, required: true, autocomplete: "email" %>
          <div class="hint">Yanıtımızı bu adrese göndereceğiz.</div>
        </div>
        <div class="field">
          <%= form.label :subject, "Konu" %>
          <%= form.text_field :subject, required: true %>
        </div>
        <div class="field">
          <%= form.label :body, "Ne oldu?" %>
          <%= form.text_area :body, rows: 6 %>
        </div>
        <div class="field">
          <%= form.label :priority, "Öncelik" %>
          <%= form.select :priority, Ticket.priorities.keys.map { |p| [ priority_label(p), p ] } %>
        </div>

        <%= form.submit "Talebi gönder", class: "button-large" %>
      <% end %>
    </div>
  </section>

  <aside class="panel">
    <h2>Ne zaman yanıt alırsınız?</h2>
    <p class="muted">Önceliğe göre ilk yanıt süresi (iş süresi):</p>
    <%= render "shared/sla_targets" %>
  </aside>
</div>
