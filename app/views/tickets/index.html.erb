<h1>Talepler</h1>

<div class="filters">
  <%= link_to "Tümü", tickets_path %>
  <%= link_to "Sadece SLA'sı geçmiş olanlar", tickets_path(filter: "sla_breached") %>
</div>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Konu</th>
      <th>Talep sahibi</th>
      <th>Öncelik</th>
      <th>Durum</th>
      <th>Atanan</th>
      <th>İlk yanıt SLA</th>
    </tr>
  </thead>
  <tbody>
    <% @tickets.each do |ticket| %>
      <tr>
        <td><%= ticket.id %></td>
        <td><%= link_to ticket.subject, ticket %></td>
        <td><%= ticket.requester_email %></td>
        <td><%= priority_label(ticket.priority) %></td>
        <td><%= status_chip(ticket.status) %></td>
        <td><%= ticket.assignee&.email_address || "—" %></td>
        <td><%= sla_badge(ticket) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @tickets.empty? %>
  <p class="muted">Bu listede talep yok.</p>
<% end %>
