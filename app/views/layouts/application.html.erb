<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "SLA Clock" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SLA Clock">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <div class="shell">
        <aside class="sidebar">
          <%= link_to root_path, class: "brand" do %>
            <%= render "shared/logo" %> SLA Clock
          <% end %>
          <nav aria-label="Temsilci menüsü">
            <%= link_to tickets_path, class: ("is-active" if controller_name == "tickets" && action_name != "new" && params[:filter].blank?) do %>
              Kuyruk <span class="count"><%= Ticket.awaiting_first_response.count %></span>
            <% end %>
            <%= link_to tickets_path(filter: "sla_breached"), class: ("is-active" if params[:filter] == "sla_breached") do %>
              SLA'sı geçenler <span class="count count-red"><%= Ticket.sla_breached.count %></span>
            <% end %>
            <%= link_to "Müşteri formu", new_ticket_path, class: ("is-active" if controller_name == "tickets" && action_name == "new") %>
          </nav>
          <div class="account">
            <span class="email"><%= Current.user.email_address %></span>
            <%= button_to "Çıkış yap", session_path, method: :delete %>
          </div>
        </aside>
        <main class="workspace">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <header class="topbar">
        <%= link_to root_path, class: "brand" do %>
          <%= render "shared/logo" %> SLA Clock
        <% end %>
        <nav aria-label="Ana menü">
          <%= link_to "Talep aç", new_ticket_path %>
          <%= link_to "Temsilci girişi", new_session_path %>
        </nav>
      </header>
      <main class="public-main">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
