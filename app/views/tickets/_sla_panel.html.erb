<section class="card sla-panel">
  <h2>İlk yanıt SLA'sı: <%= sla_badge(ticket) %></h2>
  <p class="muted">
    Öncelik <strong><%= priority_label(ticket.priority) %></strong>,
    hedef <strong><%= duration_text(SlaPolicy.first_response_minutes(ticket.priority)) %></strong> iş süresi.
    İş takvimi: Pzt–Cuma 09:00–18:00 (Türkiye saati), resmi tatiller hariç.
    "Beklemede (3. taraf)" iken sayaç durur.
  </p>

  <details>
    <summary>SLA neden bu saatte?</summary>
    <ol>
      <% SlaClock.new(ticket).compute.steps.each do |step| %>
        <li><%= sla_step_text(step) %></li>
      <% end %>
    </ol>
  </details>
</section>
