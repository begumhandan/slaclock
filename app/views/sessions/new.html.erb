<div class="auth">
  <div class="panel">
    <h1>Temsilci girişi</h1>
    <%= form_with url: session_path do |form| %>
      <div class="field">
        <%= form.label :email_address, "E-posta" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      </div>
      <div class="field">
        <%= form.label :password, "Şifre" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      </div>
      <%= form.submit "Giriş yap" %>
    <% end %>
    <%# "Sifremi unuttum" gecici olarak gizli: canlida Resend API anahtari kabul edilmedi (README: Yapamadiklarim). %>
  </div>
</div>
