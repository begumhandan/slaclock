<%= link_to "← Kuyruğa dön", tickets_path, class: "back" %>
<div class="ticket-title">
  <h1><%= @revealed ? @ticket.subject : @ticket.agent_subject %></h1>
  <%= status_chip(@ticket.status) %>
</div>
<div class="ticket-sub">
  <span class="num">#<%= @ticket.id %></span>
  <span>🔒 <%= @ticket.persona_name %> · <%= @ticket.persona_summary %></span>
  <span><%= tr_time(@ticket.created_at) %></span>
  <% if @ticket.source == "api" %><span class="chip chip-agent">Ajan API'si ile açıldı</span><% end %>
</div>

<div class="ticket-grid">
  <section aria-label="Yazışma">
    <article class="message">
      <div class="avatar" aria-hidden="true"><%= initials(@ticket.persona_name) %></div>
      <div class="bubble">
        <div class="bubble-head"><strong><%= @ticket.persona_name %></strong><span><%= tr_time(@ticket.created_at) %></span></div>
        <% shown_body = @revealed ? @ticket.body : @ticket.agent_body %>
        <%= shown_body.present? ? simple_format(shown_body) : tag.p("Açıklama yazılmadı.", class: "muted") %>
      </div>
    </article>

    <% @ticket.comments.chronological.includes(:author).each do |comment| %>
      <% author = comment.from_ai? ? "SLA Clock Asistanı 🤖" : (comment.author&.email_address || @ticket.persona_name) %>
      <article class="message <%= comment.internal ? "internal" : (comment.from_customer? ? "customer" : (comment.from_ai? ? "ai" : "agent")) %>">
        <div class="avatar" aria-hidden="true"><%= comment.from_ai? ? "AI" : initials(author) %></div>
        <div class="bubble">
          <div class="bubble-head">
            <strong><%= author %></strong>
            <span><%= tr_time(comment.created_at) %></span>
            <% if comment.internal %><span>İç not, müşteri görmez</span><% end %>
            <% if comment.from_customer? %><span>Müşteri yanıtı</span><% end %>
          </div>
          <%= simple_format(@revealed ? comment.body : comment.agent_body) %>
        </div>
      </article>
    <% end %>

    <% unless @ticket.status == "closed" %>
      <div class="panel composer">
        <%= form_with model: [ @ticket, Comment.new ] do |form| %>
          <%= form.label :body, "Yanıt yaz", class: "muted" %>
          <%= form.text_area :body, rows: 4, required: true, placeholder: "Müşteriye yanıtınız… (“#{@ticket.persona_name.split.first}” diye hitap edebilirsiniz; müşteri kendi adını görür)" %>
          <div class="composer-foot">
            <label class="toggle">
              <%= form.check_box :internal %>
              İç not olarak kaydet (müşteri görmez, ilk yanıt sayılmaz)
            </label>
            <%= form.submit "Yanıtı gönder" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <aside class="rail">
    <section class="panel">
      <h2>Durum</h2>
      <div class="actions">
        <% if @ticket.assignee != Current.user && !@ticket.closed? %>
          <%= button_to "Bana ata", assign_to_me_ticket_path(@ticket), method: :patch %>
        <% end %>
        <% @ticket.allowed_transitions.each do |target| %>
          <%= button_to status_label(target), transition_ticket_path(@ticket, to: target), method: :patch, form_class: "button_to button-quiet",
                form: (target == "closed" ? { data: { turbo_confirm: "Talep kalıcı olarak kapanacak ve bir daha açılamayacak. Emin misiniz?" } } : {}) %>
        <% end %>
        <% if @ticket.allowed_transitions.empty? %>
          <span class="muted">Kapalı talepte işlem yapılamaz.</span>
        <% end %>
      </div>
      <dl class="props" style="margin-top: 16px;">
        <dt>Atanan</dt><dd><%= @ticket.assignee&.email_address || "Atanmadı" %></dd>
        <% if @ticket.access_token %>
          <dt>Müşteri sayfası</dt><dd><%= link_to "Müşterinin gördüğü sayfa ↗", customer_ticket_path(@ticket.access_token), target: "_blank", rel: "noopener" %></dd>
        <% end %>
        <% if @ticket.solved_at %><dt>Çözülme</dt><dd><%= tr_time(@ticket.solved_at) %></dd><% end %>
        <% if @ticket.auto_solve_at %><dt>Otomatik çözülme</dt><dd><%= tr_time(@ticket.auto_solve_at) %></dd><% end %>
        <% if @ticket.auto_close_at %><dt>Otomatik kapanma</dt><dd><%= tr_time(@ticket.auto_close_at) %></dd><% end %>
      </dl>
    </section>

    <%= render "privacy_card", ticket: @ticket, revealed: @revealed %>
    <%= render "ai_card", ticket: @ticket %>
    <%= render "sla_card", ticket: @ticket %>
  </aside>
</div>
