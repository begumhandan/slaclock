<div class="form-layout">
  <section>
    <h1>Destek talebi aç</h1>
    <p class="intro">Ekibimiz talebinizi aldığı andan itibaren seçtiğiniz önceliğe göre yanıt süresini işletir.</p>

    <div class="panel">
      <%= form_with model: @ticket do |form| %>
        <% if @ticket.errors.any? %>
          <ul class="errors">
            <% @ticket.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>

        <div class="field">
          <%= form.label :requester_email, "E-posta adresiniz" %>
          <%= form.email_field :requester_email, required: true, autocomplete: "email" %>
          <div class="hint">Talebi gönderince size özel bir talep sayfası açılır; yanıtlarımızı orada görürsünüz.</div>
        </div>
        <div class="field">
          <%= form.label :subject, "Konu" %>
          <%= form.text_field :subject, required: true %>
        </div>
        <div class="field">
          <%= form.label :body, "Ne oldu?" %>
          <%= form.text_area :body, rows: 6 %>
        </div>
        <div class="field">
          <%= form.label :priority, "Öncelik" %>
          <%= form.select :priority, Ticket.priorities.keys.map { |p| [ priority_label(p), p ] } %>
        </div>

        <fieldset class="privacy-fields">
          <legend>Sizi tanımamıza yardımcı olun <span class="muted">(isteğe bağlı)</span></legend>
          <p class="hint">🔒 Destek ekibimiz ve yapay zekâ asistanımız bu bilgileri doğrudan görmez. Yalnızca
            genelleştirilmiş bir profil görürler (ör. “~21–22 yaş · mühendislik öğrencisi · Samsun”) ve size takma adla hitap ederler.
            Gerçek bilgilerinize erişim gerekçe ister ve kayda geçer.</p>
          <div class="field-row">
            <div class="field">
              <%= form.label :requester_name, "Adınız" %>
              <%= form.text_field :requester_name, autocomplete: "name", maxlength: 100 %>
            </div>
            <div class="field">
              <%= form.label :birth_year, "Doğum yılınız" %>
              <%= form.number_field :birth_year, min: 1900, max: 2020, inputmode: "numeric" %>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <%= form.label :occupation, "Mesleğiniz / okulunuz" %>
              <%= form.text_field :occupation, maxlength: 100, placeholder: "ör. Yazılım mühendisliği öğrencisi" %>
            </div>
            <div class="field">
              <%= form.label :city, "Şehir" %>
              <%= form.text_field :city, maxlength: 60 %>
            </div>
          </div>
        </fieldset>

        <%= form.submit "Talebi gönder", class: "button-large" %>
      <% end %>
    </div>
  </section>

  <aside class="panel">
    <h2>Ne zaman yanıt alırsınız?</h2>
    <p class="muted">Önceliğe göre ilk yanıt süresi (iş süresi):</p>
    <%= render "shared/sla_targets" %>
  </aside>
</div>
